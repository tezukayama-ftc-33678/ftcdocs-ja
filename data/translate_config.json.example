{
  "backend": "openai",
  "model": "gpt-4o-mini",
  "api_key": "YOUR_OPENAI_API_KEY_HERE",
  "temperature": 0.1,
  "max_retries": 3,
  "chunk_size": 400,
  "context_window": 8000,
  "skip_translated": true,
  "quality_check_enabled": true,
  
  "_comment": "Recommended models: gpt-4o-mini (fast), gpt-4.1-mini (balanced)",
  "_daily_limit": "2.5M tokens across all mini models"
}
