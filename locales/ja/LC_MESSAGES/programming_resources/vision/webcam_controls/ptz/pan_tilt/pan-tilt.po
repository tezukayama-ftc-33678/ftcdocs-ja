#: ../../source/programming_resources/vision/webcam_controls/ptz/pan_tilt/pan-tilt.rst:42
msgid "``minPanTiltHolder = getMinPanTilt();``"
msgstr "``minPanTiltHolder = getMinPanTilt();``"

#: ../../source/programming_resources/vision/webcam_controls/ptz/pan_tilt/pan-tilt.rst:43
