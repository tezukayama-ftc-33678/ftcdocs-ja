msgid "Gain Control"
msgstr "制御を取得する"

#: ../../source/programming_resources/vision/webcam_controls/gain/control/control.rst:4
msgid ""
":java:extdoc:`org.firstinspires.ftc.robotcore.external.hardware.camera.controls`"
msgstr ""
