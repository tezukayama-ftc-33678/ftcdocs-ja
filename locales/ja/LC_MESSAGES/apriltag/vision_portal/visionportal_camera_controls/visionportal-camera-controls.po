msgid ""
"*Set the gain. Right-click, “use return value” for a Boolean indicating "
"success or completion.*"
msgstr ""
"*Set the gain. Right-click, “use return value” for a Boolean indicating "
"success or completion.*"

#: ../../source/apriltag/vision_portal/visionportal_camera_controls/visionportal-camera-controls.rst:126
