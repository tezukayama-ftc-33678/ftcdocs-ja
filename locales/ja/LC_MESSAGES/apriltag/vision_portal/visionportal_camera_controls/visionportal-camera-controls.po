#: ../../source/apriltag/vision_portal/visionportal_camera_controls/visionportal-camera-controls.rst:132
msgid "Gain and Exposure"
msgstr "ゲインと露出"

#: ../../source/apriltag/vision_portal/visionportal_camera_controls/visionportal-camera-controls.rst:134
msgid "Autoexposure mode manages both gain and exposure."
msgstr "オートエクスポージャーモードは、ゲインと露出の両方を管理します。"

#: ../../source/apriltag/vision_portal/visionportal_camera_controls/visionportal-camera-controls.rst:136
msgid ""
"Gain can be adjusted only if ExposureControl Mode is set to MANUAL (not the "
"default)."
msgstr "ゲインは、ExposureControl ModeがMANUAL（デフォルトではない）に設定されている場合のみ調整できます。"

#: ../../source/apriltag/vision_portal/visionportal_camera_controls/visionportal-camera-controls.rst:139
