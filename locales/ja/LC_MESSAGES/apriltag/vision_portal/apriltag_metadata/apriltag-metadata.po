msgstr "SDK 8.2 サンプル Op Mode は、次のメタデータ値を持つ AprilTag を使用します："

#: ../../source/apriltag/vision_portal/apriltag_metadata/apriltag-metadata.rst:25
msgid "``583, Nemo, 4, DistanceUnit.INCH``"
msgstr "``583, Nemo, 4, DistanceUnit.INCH``"

#: ../../source/apriltag/vision_portal/apriltag_metadata/apriltag-metadata.rst:26
msgid "``584, Jonah, 4, DistanceUnit.INCH``"
msgstr "``584, Jonah, 4, DistanceUnit.INCH``"

#: ../../source/apriltag/vision_portal/apriltag_metadata/apriltag-metadata.rst:27
